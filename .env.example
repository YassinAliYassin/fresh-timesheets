# Fresh Timesheets — environment template
# Copy to .env for local development. NEVER commit real values.

# API port
PORT=3000

# JWT signing secret — REQUIRED in production (NODE_ENV=production).
# In dev this falls back to a marked dev-only value; Render auto-generates it.
JWT_SECRET=change-me-to-a-long-random-string

# Node environment: development | production
NODE_ENV=development

# Optional: Postgres connection string. If unset, SQLite is used (local dev).
# DATABASE_URL=postgres://user:pass@host:5432/timesheets
